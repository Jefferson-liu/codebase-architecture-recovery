# =============================================================
# Copy this file to docker.env and fill in your values:
#   cp .env.example docker.env
# Then start the stack:
#   docker compose up --build
# =============================================================

# --- LLM API keys ---
# Anthropic is required for the agent (Claude Haiku / Sonnet / Opus)
ANTHROPIC_API_KEY=

# Gemini is the default provider for backend summarization and embeddings.
# If you switch REPO_SUMMARY_MODEL_PROVIDER / REPO_EMBED_MODEL_PROVIDER to
# anthropic or openai, you can leave these blank and fill in the other key.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=   # set to the same value as GEMINI_API_KEY

# Optional: OpenAI key (only needed if MODEL=openai or REPO_SUMMARY_MODEL_PROVIDER=openai)
# PERSONAL_OPENAI_KEY=

# --- Model providers ---
# Which LLM provider the backend uses for summarization and embeddings.
# Options: gemini | anthropic | openai
REPO_SUMMARY_MODEL_PROVIDER=gemini
REPO_EMBED_MODEL_PROVIDER=gemini

# --- Repo ingestion ---
# Comma-separated container paths to allow for ingestion.
# Must match paths you mount under context-backend volumes in docker-compose.yml.
# Example: REPO_INGEST_ALLOWED_ROOTS=/repos
REPO_INGEST_ALLOWED_ROOTS=

# --- App settings ---
APP_ENV=development
VECTOR_STORE_MODE=pgvector
REPO_KNOWLEDGE_MCP_TRANSPORT=streamable-http
LOG_REPO_PROGRESS=1
SEMAPHORE_LIMIT=5

# --- Database (Docker-internal — do not change) ---
DATABASE_URL=postgresql+asyncpg://context:contextpass@postgres:5432/context

# --- Service URLs (Docker-internal — do not change) ---
PORT=4111
CONTEXT_API_BASE_URL=http://context-backend:8000/
MCP_SERVER_URL=http://context-backend:8000/mcp
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (browser-facing — do not change) ---
VITE_AGENT_API_BASE_URL=http://localhost:4111
VITE_CONTEXT_API_BASE_URL=http://localhost:8000/
